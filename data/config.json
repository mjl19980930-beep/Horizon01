{
  "version": "1.0",
  "ai": {
    "provider": "minimax",
    "model": "MiniMax-M2.7",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.2,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"]
  },
  "email": {
    "enabled": false,
    "imap_enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "disabled@example.com",
    "sender_name": "Horizon01",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {"type": "repo_releases", "owner": "openai", "repo": "openai-python", "enabled": true},
      {"type": "repo_releases", "owner": "anthropics", "repo": "anthropic-sdk-python", "enabled": true},
      {"type": "repo_releases", "owner": "modelcontextprotocol", "repo": "python-sdk", "enabled": true},
      {"type": "repo_releases", "owner": "huggingface", "repo": "transformers", "enabled": true},
      {"type": "repo_releases", "owner": "langchain-ai", "repo": "langchain", "enabled": true},
      {"type": "repo_releases", "owner": "langchain-ai", "repo": "langgraph", "enabled": true},
      {"type": "repo_releases", "owner": "microsoft", "repo": "autogen", "enabled": true},
      {"type": "repo_releases", "owner": "browser-use", "repo": "browser-use", "enabled": true}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 80
    },
    "rss": [
      {"name": "OpenAI News", "url": "https://openai.com/news/rss.xml", "enabled": true, "category": "official-ai"},
      {"name": "Anthropic News", "url": "https://www.anthropic.com/news/rss.xml", "enabled": true, "category": "official-ai"},
      {"name": "Google AI Blog", "url": "https://blog.google/technology/ai/rss/", "enabled": true, "category": "official-ai"},
      {"name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "enabled": true, "category": "ai-tools"},
      {"name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-tools"},
      {"name": "TLDR AI", "url": "https://tldr.tech/api/rss/ai", "enabled": true, "category": "ai-news"},
      {"name": "The Decoder", "url": "https://the-decoder.com/feed/", "enabled": true, "category": "ai-news"},
      {"name": "VentureBeat AI", "url": "https://venturebeat.com/category/ai/feed/", "enabled": true, "category": "ai-news"}
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {"subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 30},
        {"subreddit": "OpenAI", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 30},
        {"subreddit": "ClaudeAI", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 20},
        {"subreddit": "ChatGPTCoding", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 20}
      ],
      "users": [],
      "fetch_comments": 3
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "fetch_reply_text": false
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": ["ai", "llm", "agent", "openai", "claude", "gemini", "rag", "workflow", "automation"],
      "min_stars": 10,
      "max_items": 30
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": null,
    "headers": ""
  }
}
