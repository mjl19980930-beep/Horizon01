# 模型 Key：推荐使用 MINIMAX_API_KEY。也兼容误拼写 MINIMANX_API_KEY。
MINIMAX_API_KEY=
MINIMANX_API_KEY=

GITHUB_TOKEN=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 方式一：只有 wiki 链接时，填这个。可以填整条 wiki 链接，也可以只填 /wiki/ 后面的 token。
FEISHU_WIKI_TOKEN=

# 方式二：如果你能拿到 /base/ 链接，也可以填下面两个。FEISHU_WIKI_TOKEN 和这两个方式二选一。
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_ID=

FEISHU_AUTO_CREATE_FIELDS=true
